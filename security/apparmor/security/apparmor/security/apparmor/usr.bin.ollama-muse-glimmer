#include <tunables/global>

# ForgeOS - Muse Glimmer 30B - local agentic model
# Runs under verified boot chain: shim -> GRUB -> UKI -> dm-verity squashfs
/usr/bin/ollama flags=(complain) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Binary + libs - read-only, from verified root
  /usr/bin/ollama mr,
  /usr/lib/ollama/** mr,
  /usr/lib/** mr,
  /opt/ollama/** mr,

  # Model blobs - from signed /usr/share/models (dm-verity protected)
  /usr/share/ollama/.ollama/models/** r,
  /usr/share/models/muse-glimmer/** r,
  /var/lib/ollama/models/** r,

  # Config - read-only
  /etc/ollama/** r,
  /etc/forge-os/glimmer.conf r,

  # Writable only for inference cache / logs - isolated
  owner /var/log/forge-glimmer/** w,
  owner /var/cache/ollama/** rw,
  owner /run/ollama/** rw,

  # Network - only loopback for local agents (no cloud exfil under verified boot)
  network inet dgram,
  network inet stream,
  deny network inet6,
  deny network raw,

  # Deny everything else - no cap, no ptrace, no mount
  deny capability sys_admin,
  deny capability sys_ptrace,
  deny /proc/sys/** w,
  deny /sys/** w,
  deny /boot/** w,

  # Claude Code / Codex / Pi integration - local socket only
  unix (bind, listen) type=stream addr="@ollama-glimmer",
}
